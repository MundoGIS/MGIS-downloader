# Exempel for MGIS-Downloader bakom IIS. Kopiera till .env och anpassa lokala sokvagar.
# Lagra aldrig LMV-nycklar eller Bearer-token i denna fil eller i Git.
HOST=127.0.0.1
PORT=3004

# GDAL/QGIS maste vara installerat pa samma dator som Node.
GDAL=C:/QGIS_344/apps/gdal
QGIS=C:/QGIS_344/bin

# Anvand dessa endast om QGIS Python inte hittas automatiskt:
# GDAL_TILES_PYTHON=C:/QGIS_344/apps/Python312/python.exe
# GDAL_TILES_SCRIPT=C:/QGIS_344/apps/Python312/Scripts/gdal2tiles.py

# Valfritt: flytta konton och ihagkomna sessioner till skyddad plats utanfor webbroten.
# USERS_FILE=C:/MGIS-private/users.json
# SESSIONS_FILE=C:/MGIS-private/remembered_sessions.json