# Exempel på miljövariabler för MGIS-Downloader
# Kopiera denna fil till .env och anpassa sökvägar/nycklar.

# Sökväg till GDAL-root (valfritt om du har QGIS PATH)
GDAL="C:/QGIS/apps/gdal/"

# Sökväg till QGIS bin (valfritt)
QGIS="C:/QGIS/bin/"

# Alternativ Python-batch från QGIS (valfritt, används för vissa GDAL-skript)
#PYTHON_CMD="C:/QGIS/apps/python/python.exe"

# Port för webbserver (standard 3003)
PORT=3003

# Exempel: Lantmäteriet STAC API-nyckel (lägg inte riktiga nycklar i repo)
#LMV_API_KEY=

# Loggnivå (valfritt): info, debug, warn, error
#LOG_LEVEL=info
# Example .env for MGIS-Downloader
# Adjust paths to match your installation. Works on Windows, Linux and macOS.

# Path to GDAL installation or root folder (optional if gdal binaries are on PATH)
# Windows example: GDAL=C:/QGIS/apps/gdal/
# Linux/macOS: leave empty if gdal is installed via apt/brew and on PATH
GDAL=C:/QGIS/apps/gdal/

# QGIS installation root (optional)
# Windows example: QGIS=C:/QGIS
QGIS=C:/QGIS

# Python interpreter used to run gdal_merge.py (optional).
# Defaults to 'python' on Windows and 'python3' on Linux/macOS.
#PYTHON_CMD=python3

# Full path to gdal_merge.py. If empty, server will try to use QGIS/GDAL paths,
# falling back to 'gdal_merge.py' on PATH (Linux/macOS) or a legacy C:/QGIS path (Windows).
# Windows example: GDAL_MERGE=C:/QGIS/apps/Python312/Scripts/gdal_merge.py
# Linux example:   GDAL_MERGE=/usr/bin/gdal_merge.py
GDAL_MERGE=C:/QGIS/apps/Python312/Scripts/gdal_merge.py

# Port the server should bind to
PORT=3003

# --- SÄKERHET / DRIFT BAKOM REVERSE PROXY (t.ex. IIS + URL Rewrite/ARR) ---

# HOST: nätverksgränssnitt Node ska lyssna på.
# Standard: 127.0.0.1 (endast lokal åtkomst - rekommenderas bakom IIS/reverse proxy).
# Sätt till 0.0.0.0 ENDAST om Node ska nås direkt utan proxy framför (t.ex. i en sluten testmiljö).
HOST=127.0.0.1

# TRUST_PROXY: krävs när appen körs bakom IIS/ARR, nginx eller annan reverse proxy,
# så att express-rate-limit och loggning ser klientens riktiga IP (via X-Forwarded-For).
# Sätt till antal hopp (t.ex. 1 om IIS ligger direkt framför Node). Lämna tom om appen
# nås direkt utan proxy.
#TRUST_PROXY=1

# ALLOWED_ORIGINS: kommaseparerad lista med tillåtna origins för CORS.
# Lämna tom om appen bara nås via samma domän/URL som IIS publicerar (rekommenderas -
# ingen inloggning finns i appen, så CORS bör hållas så restriktivt som möjligt).
# Exempel om ett annat intranät/subdomän behöver anropa API:t direkt:
#ALLOWED_ORIGINS=https://mgis.example.se

# Rate limiting (skydd mot enkel DoS/skrapning av API:t).
# RATE_LIMIT_* gäller alla rutter, DOWNLOAD_RATE_LIMIT_* gäller de tunga
# nedladdningsstartande rutterna (/create-download, /lmv/start-full-download).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
DOWNLOAD_RATE_LIMIT_WINDOW_MINUTES=15
DOWNLOAD_RATE_LIMIT_MAX=20

